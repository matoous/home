[alias]
  aliases = !git config --get-regexp alias | sed -re 's/alias\\.(\\S*)\\s(.*)$/\\1 = \\2/g'
  w = switch hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  c = commit
  f = fetch
  b = branch
  s = status
  p = pull
  d = diff
  lo = log --oneline -n 10
  lg = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset'
  unstage = reset HEAD
  pushf = push --force-with-lease
  cane = commit --amend --no-edit
  reword = commit --amend
  uncommit = reset --soft HEAD~1
  untrack = rm --cache --
  cmt = !git add . && git commit --amend && git push --force-with-lease

[core]
  editor = ms
  autocrlf = input
  pager = delta
  whitespace = trailing-space,space-before-tab
  excludesfile = ~/.config/git/.gitignore
  attributesfile = ~/.config/git/.gitattributes
  fsmonitor = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[color]
  ui = auto

[diff]
  mnemonicPrefix = true
  renames = true
  colorMoved = default

[difftool]
  prompt = false

[log]
  abbrevCommit = true
  follow = true

[apply]
  whitespace = fix

[credential]
  helper = osxkeychain

[pull]
  rebase = true

[rerere]
  enabled = true
  autoupdate = true

[protocol]
  version = 2

[init]
  defaultBranch = main

[fetch]
  prune = true
  pruneTags = true
  all = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[push]
  default = current
  autoSetupRemote = true
  followTags = true

[commit]
  verbose = true

[tag]
  sort = version:refname

[interactive]
  diffFilter = delta --color-only

[help]
  autocorrect = prompt

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[delta]
  navigate = true
  side-by-side = true

[merge]
  conflictStyle = diff3

[include]
  path = ~/.config/gitconfig.local
